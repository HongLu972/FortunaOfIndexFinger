<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8E0D5">

    <LinearLayout
        android:id="@+id/top_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="16dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="福尔图娜的纸条"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#5D4037" />

        <!-- 在 top_stats 的 LinearLayout 中追加 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="食指 编外成员"
            android:textSize="18sp"
            android:textColor="#4E342E"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_karma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:text="业(福尔图娜): 0"
                android:textSize="16sp"
                android:textColor="#D32F2F"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/tv_blessing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:text="指令加护: 0"
                android:textSize="16sp"
                android:textColor="#388E3C" />
        </LinearLayout>
    </LinearLayout>

    <!-- ★ 中间：纸条堆叠容器（自动填满剩余空间） ★ -->
    <FrameLayout
        android:id="@+id/stack_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/top_stats"
        android:layout_above="@+id/addPrescriptArea"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_marginBottom="80dp"
        android:id="@+id/addPrescriptArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:weightSum="10">
        <TextView
            android:id="@+id/weigthtaker"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
        <!-- ★ 底部：新增指令按钮 ★ -->
        <Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#00FFCE"
            android:textColor="#000000"
            android:layout_weight="3"
            android:text="获取指令" />

        <TextView
            android:id="@+id/weigthtakerII"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/add_butten"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:backgroundTint="#00FFCE"
            android:textColor="#000"
            android:text="获取100次指令"/>

    </LinearLayout>

    <!-- ★ 底部工具栏（占位，后面再决定放什么） ★ -->
    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#D7CCC8"
        android:weightSum="3">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#00FFCE"
            android:textColor="#000000"
            android:text="主页"/>

        <Button
            android:id="@+id/nav_stats"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#00FFCE"
            android:textColor="#000000"
            android:text="战斗"/>



        <Button
            android:id="@+id/nav_setting"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:backgroundTint="#00FFCE"
            android:textColor="#000000"
            android:text="设置"/>

    </LinearLayout>

</RelativeLayout>